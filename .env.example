# Google Sheets (service account)
# 1. Create a Google Cloud project + service account
# 2. Enable Google Sheets API
# 3. Download JSON key; copy client_email and private_key
# 4. Create a Sheet with a tab named "emails"
# 5. Share the Sheet with the service account email (Editor)
# 6. Header row (optional): timestamp | first | last | preferred | email | phone | city_state | grad_note | hear_about | source

GOOGLE_SERVICE_ACCOUNT_EMAIL=reunion-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id_from_the_url
